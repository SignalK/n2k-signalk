  "dependencies": {
    "@canboat/ts-pgns": "^3.1.0",
    "camelcase": "^10.0.0",
    "debug": "^4.0.0",
    "JSONStream": "~1.3.0",
    "lodash": "^4.17.11",
    "through": ">=2.2.7 <3"
  },
  "devDependencies": {
    "@canboat/canboatjs": "^4.0.0-beta.4",
    "@eslint/js": "^9.39.5",
    "@signalk/server-api": "^1.39.0",
    "@signalk/signalk-schema": "1.3.1",
    "@tsconfig/node20": "^20.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "chai": "~4.1.0",
    "chai-things": "0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tv4": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  }
