{
  "name": "@signalk/n2k-signalk",
  "version": "5.0.0-beta.3",
  "description": "NMEA 2000 to SignalK conversion library",
  "main": "dist/n2kMapper.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mocha",
    "format": "prettier-standard '*.ts' '{pgns,actisense,digitalyacht,fusion,lowrance,maretron,navico,raymarine,simrad}/**/*.ts' 'test/**/*.{js,ts}' 'bin/*.js'",
    "ci-format": "prettier-standard --check '*.ts' '{pgns,actisense,digitalyacht,fusion,lowrance,maretron,navico,raymarine,simrad}/**/*.ts' 'test/**/*.{js,ts}' 'bin/*.js'",
    "build": "tsc -b --pretty false",
    "watch": "tsc --watch --pretty false",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nmea",
    "2000",
    "n2k",
    "signalk",
    "navigation",
    "sailing",
    "boating"
  ],
  "author": "teppo.kurki@iki.fi",
  "license": "Apache-2.0",
  "repository": "https://github.com/SignalK/n2k-signalk",
  "dependencies": {
    "@canboat/ts-pgns": "^3.1.0",
    "camelcase": "^6.2.0",
    "debug": "^4.0.0",
    "JSONStream": "~1.3.0",
    "lodash": "^4.17.11",
    "through": ">=2.2.7 <3"
  },
  "devDependencies": {
    "@canboat/canboatjs": "^4.0.0-beta.4",
    "@signalk/server-api": "^2.35.0",
    "@signalk/signalk-schema": "1.8.2",
    "@tsconfig/node20": "^20.1.6",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "~6.3.0",
    "chai-things": "0.2",
    "mocha": "^12.0.3",
    "prettier-standard": "^16.0.0",
    "ts-node": "^10.9.2",
    "tv4": "latest",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
